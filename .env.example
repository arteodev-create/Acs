PORT=4000
NODE_ENV=development
BUILD_ID=RECODE_API_LOCAL
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://recode.arteosocial.com

# Supabase / PostgreSQL
# Prefer the pooled Supabase connection string when using Supabase.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Or use individual PostgreSQL values.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=recode_social
PGUSER=postgres
PGPASSWORD=change-me
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=C:/path/to/postgres-ca.pem
DB_CONNECTION_LIMIT=25
DB_CONNECT_TIMEOUT_MS=30000

# Optional aliases.
AWS_REGION=ap-southeast-1
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSL=true

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Indexing API
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Daily AI blog automation
# Keep the real key only on the server. Never expose it in frontend code.
AI_DAILY_POST_ENABLED=false
AI_DAILY_POST_START_DATE=2025-05-03
AI_DAILY_POST_TIMEZONE=Asia/Bangkok
AI_DAILY_POST_MODEL=inclusionai/ling-2.6-1t:free
AI_DAILY_POST_AUTHOR_ID=
AI_DAILY_POST_MAX_TOKENS=1200
AI_DAILY_POST_TIMEOUT_MS=60000
AI_DAILY_POST_DRY_RUN=false
OPENROUTER_API_KEY=

# Daily community learning activity.
# Creates clearly synthetic demo users and accurate educational content.
DAILY_ACTIVITY_ENABLED=false
DAILY_ACTIVITY_TIMEZONE=Asia/Bangkok
DAILY_ACTIVITY_MIN_USERS=30
DAILY_ACTIVITY_MAX_USERS=100
DAILY_ACTIVITY_MIN_THREADS=8
DAILY_ACTIVITY_MAX_THREADS=20
DAILY_ACTIVITY_MIN_REPLIES=20
DAILY_ACTIVITY_MAX_REPLIES=80
DAILY_ACTIVITY_MIN_TEMPLATES=5
DAILY_ACTIVITY_MAX_TEMPLATES=12
DAILY_ACTIVITY_MIN_BLOGS=1
DAILY_ACTIVITY_MAX_BLOGS=2

# Optional cache / security
REDIS_URL=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
